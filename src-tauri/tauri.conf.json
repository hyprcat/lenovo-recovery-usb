{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recovery USB Maker",
  "version": "0.1.0",
  "identifier": "io.github.hyprcat.recoveryusbmaker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Recovery USB Maker",
        "width": 480,
        "height": 540,
        "minWidth": 420,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Make a Lenovo factory-recovery USB stick without Windows",
    "longDescription": "Signs in with your Lenovo ID, downloads your laptop's factory-recovery order and writes a bootable recovery USB stick, like Lenovo's Windows-only USB Recovery Creator. Unofficial, not affiliated with Lenovo.",
    "copyright": "Copyright (c) 2026 hyprcat",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["dosfstools", "util-linux", "pkexec | policykit-1"]
      },
      "rpm": {
        "depends": ["dosfstools", "util-linux", "polkit"]
      }
    }
  }
}
